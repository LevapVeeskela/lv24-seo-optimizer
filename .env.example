# lv24-seo-optimizer — configuration template
# Copy to `.env` (git-ignored) or export the variables in your shell.
# Every value is optional: the default path needs no paid key at all.

# ---------- Google Search Console ----------
# Either an OAuth client (loopback flow) or a service-account JSON key that was added
# to the property as Full/Owner. Prefer OAuth for a domain property you control.
LV24_SEO_GSC_CLIENT_ID=
LV24_SEO_GSC_CLIENT_SECRET=
LV24_SEO_GSC_SERVICE_ACCOUNT_FILE=
LV24_SEO_GSC_PROPERTY=sc-domain:example.com

# ---------- Yandex Webmaster ----------
# Scope: webmaster:hostinfo (+ webmaster:verify if you add hosts programmatically).
LV24_SEO_YANDEX_WEBMASTER_TOKEN=
LV24_SEO_YANDEX_HOST_ID=https:example.com:443

# ---------- Yandex Metrika ----------
# Scope: metrika:read
LV24_SEO_YANDEX_METRIKA_TOKEN=
LV24_SEO_YANDEX_METRIKA_COUNTER=

# ---------- Bing Webmaster + IndexNow ----------
LV24_SEO_BING_API_KEY=
LV24_SEO_INDEXNOW_KEY=

# ---------- Chrome UX Report / PageSpeed Insights ----------
LV24_SEO_CRUX_API_KEY=""
LV24_SEO_PSI_API_KEY=

# ---------- Optional paid adapters (BYO key; disabled by default) ----------
LV24_SEO_DATAFORSEO_LOGIN=
LV24_SEO_DATAFORSEO_PASSWORD=""
LV24_SEO_SERPAPI_KEY=

# ---------- Delivery ----------
LV24_SEO_SMTP_HOST=
LV24_SEO_SMTP_PORT=587
LV24_SEO_SMTP_USER=
LV24_SEO_SMTP_PASSWORD=
LV24_SEO_SMTP_FROM=seo@example.com
LV24_SEO_MAIL_TO=owner@example.com
LV24_SEO_TELEGRAM_BOT_TOKEN=
LV24_SEO_TELEGRAM_CHAT_ID=

# ---------- Storage / behaviour ----------
LV24_SEO_DATA_DIR=./data
LV24_SEO_LOG_LEVEL=INFO
# Set to 1 only in CI/containers where keyring is unavailable.
LV24_SEO_ALLOW_FILE_SECRETS=0
